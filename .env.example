HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (used by both Strapi and the docker-compose mysql service)
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
# Only used by the mysql container (MYSQL_ROOT_PASSWORD)
DATABASE_ROOT_PASSWORD=tobemodified

# Firebase (path is read relative to the app root, incl. inside the container)
GOOGLE_APPLICATION_CREDENTIALS=./.firebase-service-account.json
