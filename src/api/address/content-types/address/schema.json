{
  "kind": "collectionType",
  "collectionName": "addresses",
  "info": {
    "singularName": "address",
    "pluralName": "addresses",
    "displayName": "Address"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string"
    },
    "contactName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "taxId": {
      "type": "string"
    },
    "line1": {
      "type": "string"
    },
    "line2": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "province": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::province.province"
    },
    "district": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::district.district"
    },
    "subdistrict": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subdistrict.subdistrict"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "addresses"
    }
  }
}
