{
  "kind": "collectionType",
  "collectionName": "registrations",
  "info": {
    "singularName": "registration",
    "pluralName": "registrations",
    "displayName": "Registration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "registrations"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "nameOnCertificate": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "registerDate": {
      "type": "datetime"
    },
    "registerStatus": {
      "type": "enumeration",
      "enum": [
        "REGISTERED",
        "PAYMENT_PENDING",
        "PAYMENT_RECEIVED",
        "ENROLLED",
        "WAIT_LIST",
        "WAIT_LIST_OPEN",
        "CANCELLED"
      ]
    },
    "uploads": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "receipt": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "receiptAddress": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::address.address"
    },
    "certificateAddress": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::address.address"
    },
    "remark": {
      "type": "text"
    },
    "foodOption": {
      "type": "enumeration",
      "enum": [
        "GENERAL",
        "MUSLIM",
        "VEGETARIAN",
        "OTHER"
      ]
    },
    "foodOptionOther": {
      "type": "text"
    },
    "foodAllergyDetail": {
      "type": "text"
    }
  }
}
